<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>cz.example.perf</groupId>
  <artifactId>__PROJECT_NAME__</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <gatling.version>3.14.9</gatling.version>
    <gatling-maven-plugin.version>4.21.5</gatling-maven-plugin.version>
    <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
    <junit.version>5.11.4</junit.version>
    <kotlin.version>2.2.0</kotlin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib-jdk8</artifactId>
      <version>${kotlin.version}</version>
    </dependency>
    <dependency>
      <groupId>io.gatling</groupId>
      <artifactId>gatling-core-java</artifactId>
      <version>${gatling.version}</version>
    </dependency>
    <dependency>
      <groupId>io.gatling</groupId>
      <artifactId>gatling-http-java</artifactId>
      <version>${gatling.version}</version>
    </dependency>
    <dependency>
      <groupId>io.gatling.highcharts</groupId>
      <artifactId>gatling-charts-highcharts</artifactId>
      <version>${gatling.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-test-junit5</artifactId>
      <version>${kotlin.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src/main/kotlin</sourceDirectory>
    <testSourceDirectory>src/test/kotlin</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.codehaus.gmaven</groupId>
        <artifactId>groovy-maven-plugin</artifactId>
        <version>2.1.1</version>
        <executions>
          <execution>
            <id>generate-paths</id>
            <phase>generate-sources</phase>
            <goals><goal>execute</goal></goals>
            <configuration>
              <source><![CDATA[
                def envDir = new File(project.basedir, 'src/main/resources/env')
                def load = { f -> def p = new Properties(); f.withReader('UTF-8') { p.load(it) }; p }
                def keys = new ArrayList(load(new File(envDir, 'test.properties')).stringPropertyNames())
                Collections.sort(keys)
                envDir.listFiles().findAll { it.name.endsWith('.properties') }.each { f ->
                    def fileKeys = load(f).stringPropertyNames() as Set
                    if (fileKeys != (keys as Set)) {
                        fail("Key set mismatch in ${f.name}")
                    }
                }
                def outDir = new File(project.build.directory, 'generated-sources/paths/cz/example/perf/config')
                outDir.mkdirs()
                def sb = new StringBuilder()
                sb.append('// GENERATED - do not edit. Source of keys: src/main/resources/env/test.properties\n')
                sb.append('package cz.example.perf.config\n\nobject Paths {\n')
                keys.each { k -> sb.append("    val ${k}: String get() = Env[\"${k}\"]\n") }
                sb.append('}\n')
                new File(outDir, 'Paths.kt').setText(sb.toString(), 'UTF-8')
              ]]></source>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>add-generated-paths</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources><source>${project.build.directory}/generated-sources/paths</source></sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <version>${kotlin.version}</version>
        <executions>
          <execution>
            <id>compile</id>
            <phase>process-sources</phase>
            <goals><goal>compile</goal></goals>
          </execution>
          <execution>
            <id>test-compile</id>
            <phase>process-test-sources</phase>
            <goals><goal>test-compile</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>io.gatling</groupId>
        <artifactId>gatling-maven-plugin</artifactId>
        <version>${gatling-maven-plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>com.github.ozsie</groupId>
        <artifactId>detekt-maven-plugin</artifactId>
        <version>1.23.7</version>
        <configuration>
          <input>${project.basedir}/src/main/kotlin</input>
          <config>${project.basedir}/detekt.yml</config>
          <report>
            <report>txt:${project.build.directory}/detekt/detekt.txt</report>
            <report>html:${project.build.directory}/detekt/detekt.html</report>
          </report>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
